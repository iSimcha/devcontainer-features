{
    "name": "devcontainer-features development container",
    // https://github.com/devcontainers/images/blob/main/src/base-debian/history/1.0.9.md
    "image": "mcr.microsoft.com/devcontainers/base:1-debian-12",
    "hostRequirements": {
        // Default is 2 cores/8 GB memory
        "cpus": 2,
        "memory": "8gb"
    },
    "features": {
        // The repo's own features, pulled from ghcr.io. Local ./ feature paths only work inside .devcontainer/.
        "ghcr.io/isimcha/devcontainer-features/dev-shell:1": {},
        "ghcr.io/devcontainers/features/node:2.1.1": {},
        "ghcr.io/isimcha/devcontainer-features/dev-tools:1": {},
        // `devcontainer features test` needs a Docker daemon.
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
    },
    "waitFor": "onCreateCommand",
    "updateContentCommand": {
        "git-submodule": "git submodule update --init"
    },
    // Re-initializes the common submodule on every start, so a container created before it existed picks it up.
    "postStartCommand": {
        "git-submodule": "git submodule update --init"
    },
    "customizations": {
        "codespaces": {
            "openFiles": ["README.md"],
            // Read-only token for the private common submodule. https://docs.github.com/en/codespaces/managing-your-codespaces/managing-repository-access-for-your-codespaces
            "repositories": {
                "iSimcha/common": { "permissions": { "contents": "read" } }
            }
        },
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "github.vscode-github-actions",
                "redhat.vscode-yaml",
                "skellock.just",
                "streetsidesoftware.code-spell-checker",
                "TheNuProjectContributors.vscode-nushell-lang",
                "timonwong.shellcheck"
            ]
        }
    }
}
